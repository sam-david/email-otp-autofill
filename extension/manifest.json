{
  "manifest_version": 3,
  "name": "Email Code Autofill",
  "version": "0.1.0",
  "description": "Fills the verification code a site just emailed you, pulled from Gmail and matched to the site you're on.",
  "key": "",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "oauth2": {
    "client_id": "683050516286-9p3stsee1f5bijpeb8oj00m4gim71ic8.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-code": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Fill the latest email code into this page"
    }
  },
  "action": { "default_title": "Email Code Autofill settings" },
  "options_page": "options.html"
}
